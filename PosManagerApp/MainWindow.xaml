<Window x:Class="PosManagerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PosManagerApp.Views"
        Title="Sistema Punto de Venta"
        Width="1400"
        Height="850"
        WindowStartupLocation="CenterScreen"
        MinWidth="1200"
        MinHeight="700">

    <Grid Background="{StaticResource BackgroundBrush}">

        <Grid.ColumnDefinitions>
            
            <ColumnDefinition Width="220"/>
            
            <ColumnDefinition Width="*"/>
            
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->

        <Border Grid.Column="0"
                Background="{StaticResource PanelBrush}">

            <DockPanel LastChildFill="True">

                <!-- Botón Salir -->
                
                <StackPanel DockPanel.Dock="Bottom" Margin="15">

                    <Button x:Name="BtnSalir"
                            Style="{StaticResource DangerButton}"
                            Content="Salir"
                            Click="Salir_Click"/>

                </StackPanel>

                <StackPanel>
                    
                    <StackPanel Margin="0, 15, 0, 0" HorizontalAlignment="Center">

                        <Image Width="48"
                               Height="48"
                               Source="/Resources/Icons/logo.png"/>

                        <TextBlock Text="SalesPro"
                                   Style="{StaticResource SubtitleText}"
                                   Margin="0,5,0,0"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                    <Separator Margin="15"/>

                    <Button x:Name="BtnBancos"
                            Content="🏦  Gestión de Bancos"
                            Grid.Row="0"
                            Style="{StaticResource NavigationButton}"
                            Click="Bancos_Click"/>


                    <Button x:Name="BtnVentas"
                            Content="🛒  Registrar Venta"
                            Grid.Row="1"
                            Style="{StaticResource NavigationButton}"
                            Click="Ventas_Click"/>

                </StackPanel>

            </DockPanel>

        </Border>

        <!-- CONTENIDO -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>

                <RowDefinition Height="70"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>

            <!-- Header -->

            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBrush}"
                    BorderBrush="{StaticResource SeparatorBrush}"
                    BorderThickness="0,0,0,1">

                <Grid Margin="25,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="PageTitle"
                               Text="Sistema Punto de Venta"
                               Style="{StaticResource TitleText}"
                               VerticalAlignment="Center" TextAlignment="Center"/>

                </Grid>

            </Border>

            <!-- Contenido -->

            <ContentControl x:Name="MainContent"
                            Grid.Row="1"/>

        </Grid>

    </Grid>

</Window>