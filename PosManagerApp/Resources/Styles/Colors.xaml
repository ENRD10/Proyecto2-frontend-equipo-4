<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fondo -->

    <Color x:Key="BackgroundColor">#0B0F13</Color>
    <Color x:Key="PanelColor">#12181F</Color>
    <Color x:Key="CardColor">#171E28</Color>
    
    <!-- Primario -->

    <Color x:Key="PrimaryColor">#007FFF</Color>
    <Color x:Key="PrimaryHoverColor">#0066CC</Color>

    <!-- Secundario -->

    <Color x:Key="SecondaryColor">#1E2631</Color>
    <Color x:Key="SecondaryHoverColor">#293443</Color>

    <!-- Bordes -->

    <Color x:Key="BorderColor">#1F2937</Color>

    <!-- Texto -->

    <Color x:Key="PrimaryTextColor">#FFFFFF</Color>
    <Color x:Key="SecondaryTextColor">#94A3B8</Color>
    <Color x:Key="HintTextColor">#4B5563</Color>

    <!-- Navegación -->

    <Color x:Key="NavigationColor">#20242A</Color>
    <Color x:Key="NavigationHoverColor">#31363F</Color>
    <Color x:Key="NavigationSelectedColor">#2D8CFF</Color>

    <!-- Header -->

    <Color x:Key="HeaderColor">#252A31</Color>

    <!-- Tarjetas -->

    <Color x:Key="CardHoverColor">#363C45</Color>

    <!-- Estados -->

    <Color x:Key="DangerColor">#D9534F</Color>
    <Color x:Key="DangerHoverColor">#C9302C</Color>

    <Color x:Key="SuccessColor">#28A745</Color>
    <Color x:Key="SuccessHoverColor">#218838</Color>

    <Color x:Key="WarningColor">#F0AD4E</Color>
    
    <Color x:Key="InfoColor">#5BC0DE</Color>

    <!-- Deshabilitado -->

    <Color x:Key="DisabledColor">#5E6670</Color>

    <!-- Separadores -->

    <Color x:Key="SeparatorColor">#3B414A</Color>
    
</ResourceDictionary>