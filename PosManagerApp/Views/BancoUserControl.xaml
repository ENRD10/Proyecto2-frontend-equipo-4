<UserControl x:Class="PosManagerApp.Views.BancoUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="25">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="25"/>
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <!-- LISTA -->

        <Grid Grid.Column="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Bancos registrados"
                       Style="{StaticResource SubtitleText}"/>

            <!-- Buscar -->

            <TextBox Grid.Row="2"
                     Height="42"
                     VerticalAlignment="Top"
                     Margin="0,0,0,10"
                     Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Buscar banco..."/>

            <!-- DataGrid -->

            <DataGrid Grid.Row="2"
                      Margin="0,55,0,0"
                      ItemsSource="{Binding Bancos}"
                      SelectedItem="{Binding SelectedBanco}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="Código"
                        Binding="{Binding CodigoIdentificador}"
                        Width="110"/>

                    <DataGridTextColumn
                        Header="Nombre"
                        Binding="{Binding Nombre}"
                        Width="*"/>

                    <DataGridTextColumn
                        Header="País"
                        Binding="{Binding Pais}"
                        Width="120"/>

                    <DataGridTextColumn
                        Header="Ciudad"
                        Binding="{Binding Ciudad}"
                        Width="120"/>

                    <DataGridCheckBoxColumn
                        Header="Activo"
                        Binding="{Binding Activo}"
                        Width="80"/>

                </DataGrid.Columns>

            </DataGrid>

            <!-- Botones -->

            <UniformGrid Grid.Row="4"
                         Columns="3"
                         Margin="0,5,0,0">

                <Button Content="Nuevo"
                        Margin="5"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding NewCommand}"/>

                <Button Content="Eliminar"
                        Margin="5"
                        Style="{StaticResource DangerButton}"
                        Command="{Binding DeleteCommand}"/>

                <Button Content="Actualizar"
                        Margin="5"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding RefreshCommand}"/>

            </UniformGrid>

        </Grid>

        <!-- FORMULARIO -->

        <Border Grid.Column="2"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20, 20, 10, 20">

            <ScrollViewer>

                <StackPanel>

                    <TextBlock Text="{Binding FormTitle}"
                               Style="{StaticResource SubtitleText}"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="ID"
                               Style="{StaticResource LabelText}"/>
                    <TextBox Text="{Binding BancoActual.Id}" IsReadOnly="True"/>

                    <TextBlock Text="Código"
                               Margin="0,15,0,0"
                               Style="{StaticResource LabelText}"/>
                    <TextBox Text="{Binding BancoActual.CodigoIdentificador}"/>

                    <TextBlock Text="Nombre"
                               Margin="0,15,0,0"
                               Style="{StaticResource LabelText}"/>
                    <TextBox Text="{Binding BancoActual.Nombre}"/>

                    <TextBlock Text="Email"
                               Margin="0,15,0,0"
                               Style="{StaticResource LabelText}"/>
                    <TextBox Text="{Binding BancoActual.Email}"/>

                    <TextBlock Text="Teléfono"
                               Margin="0,15,0,0"
                               Style="{StaticResource LabelText}"/>
                    <TextBox Text="{Binding BancoActual.Telefono}"/>

                    <TextBlock Text="Dirección"
                               Margin="0,15,0,0"
                               Style="{StaticResource LabelText}"/>
                    <TextBox Text="{Binding BancoActual.Direccion}"/>

                    <TextBlock Text="Ciudad"
                               Margin="0,15,0,0"
                               Style="{StaticResource LabelText}"/>
                    <TextBox Text="{Binding BancoActual.Ciudad}"/>

                    <TextBlock Text="Estado / Provincia"
                               Margin="0,15,0,0"
                               Style="{StaticResource LabelText}"/>
                    <TextBox Text="{Binding BancoActual.EstadoPais}"/>

                    <TextBlock Text="País"
                               Margin="0,15,0,0"
                               Style="{StaticResource LabelText}"/>
                    <TextBox Text="{Binding BancoActual.Pais}"/>

                    <TextBlock Text="ZIP"
                               Margin="0,15,0,0"
                               Style="{StaticResource LabelText}"/>
                    <TextBox Text="{Binding BancoActual.Zip}"/>

                    <TextBlock Text="Fax"
                               Margin="0,15,0,0"
                               Style="{StaticResource LabelText}"/>
                    <TextBox Text="{Binding BancoActual.Fax}"/>

                    <CheckBox Margin="0,20,0,0"
                              Content="Banco activo"
                              IsChecked="{Binding BancoActual.Activo}"/>

                    <Button Margin="0,30,0,0"
                            Height="45"
                            Content="Guardar"
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding SaveCommand}"/>

                </StackPanel>

            </ScrollViewer>

        </Border>

    </Grid>

</UserControl>