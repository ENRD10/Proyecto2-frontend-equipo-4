<Window x:Class="PosManagerApp.Views.SeleccionProductoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar producto"
        Width="950"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="15"/>

            <RowDefinition Height="19*"/>

        </Grid.RowDefinitions>

        <!-- BUSCADOR -->

        <StackPanel Margin="0,0,0,15" Grid.ColumnSpan="2">

            <TextBlock
                Text="Buscar producto"
                Style="{StaticResource LabelText}"/>

            <TextBox
                Margin="0,5,0,0"
                Height="38"
                Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}"
                ToolTip="Buscar por nombre..."/>

        </StackPanel>

        <!-- CONTENIDO -->

        <Grid Grid.Row="2" Grid.RowSpan="2">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="2.5*"/>

                <ColumnDefinition Width="20"/>

                <ColumnDefinition Width="2*"/>

            </Grid.ColumnDefinitions>

            <!-- PRODUCTOS -->

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Productos}"
                      SelectedItem="{Binding ProductoSeleccionado}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      MouseDoubleClick="Productos_MouseDoubleClick">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="Código"
                        Binding="{Binding CodigoBarra}"
                        Width="120"/>

                    <DataGridTextColumn
                        Header="Nombre"
                        Binding="{Binding NombreEtiqueta}"
                        Width="*"/>

                </DataGrid.Columns>

            </DataGrid>

            <!-- PANEL DERECHO -->

            <Border Grid.Column="2"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="15">

                <DockPanel>

                    <!-- BOTONES -->

                    <StackPanel DockPanel.Dock="Bottom">

                        <Button
                            Height="40"
                            Margin="0,0,0,10"
                            Style="{StaticResource SuccessButton}"
                            Content="Agregar"
                            Command="{Binding AceptarCommand}"/>

                        <Button
                            Height="40"
                            Style="{StaticResource SecondaryButton}"
                            Content="Cancelar"
                            Command="{Binding CancelarCommand}"/>

                    </StackPanel>

                    <!-- RESUMEN -->
                    <StackPanel>
                        <TextBlock
                            Text="Información"
                            Style="{StaticResource SubtitleText}"
                            Margin="0,0,0,20"/>

                        <!-- CÓDIGO -->
                        <DockPanel Margin="0,0,0,15">
                            <TextBlock Text="Código" Style="{StaticResource LabelText}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ProductoSeleccionado.CodigoBarra}" Style="{StaticResource SubLabel}" TextAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- NOMBRE -->
                        <DockPanel Margin="0,0,0,15">
                            <TextBlock Text="Nombre" Style="{StaticResource LabelText}" DockPanel.Dock="Left" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding ProductoSeleccionado.NombreEtiqueta}" Style="{StaticResource SubLabel}" TextAlignment="Right" TextWrapping="Wrap" VerticalAlignment="Top"/>
                        </DockPanel>

                        <!-- PRECIO -->
                        <DockPanel Margin="0,0,0,15">
                            <TextBlock Text="Precio" Style="{StaticResource LabelText}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ProductoSeleccionado.PrecioNeto, StringFormat=C}" Style="{StaticResource SubLabel}" TextAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- IVA -->
                        <DockPanel Margin="0,0,0,15">
                            <TextBlock Text="IVA" Style="{StaticResource LabelText}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ProductoSeleccionado.PorcentajeImpuesto, StringFormat={}{0}%}" Style="{StaticResource SubLabel}" TextAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- EXISTENCIAS -->
                        <DockPanel Margin="0,0,0, 20">
                            <TextBlock Text="Existencias" Style="{StaticResource LabelText}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ProductoSeleccionado.ExistenciaEnStock}" Style="{StaticResource SubLabel}" TextAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- CANTIDAD A AGREGAR -->
                        <TextBlock Text="Cantidad" Style="{StaticResource LabelText}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Cantidad}" Height="40" VerticalContentAlignment="Center"/>
                    </StackPanel>

                </DockPanel>

            </Border>

        </Grid>

    </Grid>

</Window>